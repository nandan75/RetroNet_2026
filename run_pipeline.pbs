#OUTROOT="samplesheet_90X_0Pt060Pt1"
OUTROOT="samplesheet_90X_0Pt021"
OUTDIR="${OUTROOT}"
mkdir -p "$OUTDIR"


#SAMPLES_FILE="samplesheet_03-0056.csv"
