# Load nextflow module
module load java/jdk-17.0.2 nextflow/24.04.1

cd $PBS_O_WORKDIR

mkdir -p cache_dirs/{singularity_cache,nextflow_singularity_cache,singularity_temp}

export CACHE_BASE=$(pwd)/cache_dirs
export SINGULARITY_CACHEDIR="$CACHE_BASE/singularity_cache"
export NXF_SINGULARITY_CACHEDIR="$CACHE_BASE/nextflow_singularity_cache"
export SINGULARITY_TMPDIR="$CACHE_BASE/singularity_temp"

export SINGULARITY_MOUNT_TIMEOUT=900
export NXF_JAVA_OPTIONS="-Xmx120G"  # Adjust as needed

#-with-dag dag.png 

#OUTROOT="bwa1_whitelist_06AndPt1"
#OUTROOT="oncoanalyserRef_redux_noCollate"
