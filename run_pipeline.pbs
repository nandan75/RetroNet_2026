#SAMPLES_FILE="samplesheet_90X_0Pt060Pt1.csv"
#SAMPLES_FILE="samplesheet_90X_0Pt30Pt5.csv"
SAMPLES_FILE="samplesheet_90X_0Pt021.csv"

nextflow run main.nf -resume --samples "$SAMPLES_FILE" \
	-with-trace "${OUTDIR}/trace.tsv" \
  	-with-report "${OUTDIR}/report.html" \
  	-with-timeline "${OUTDIR}/timeline.html"



